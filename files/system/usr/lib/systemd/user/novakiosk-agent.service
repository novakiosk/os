[Unit]
Description=NOVA Kiosk graphical companion (kiosk user)
ConditionUser=kiosk
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/novakiosk-agent runtime --state-dir /var/lib/novakiosk-runtime
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=default.target

{
  "default": [
    {
      "type": "reject"
    }
  ],
  "transports": {
    "docker": {
      "ghcr.io/novakiosk/os": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/pki/containers/novakiosk.pub",
          "signedIdentity": {
            "type": "matchRepository"
          }
        }
      ]
    }
  }
}
